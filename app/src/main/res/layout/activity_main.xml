<?xml version="1.0" encoding="utf-8"?>
<!-- Root là FrameLayout để FloatingNavBar có thể nổi tự do ở mọi vị trí -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Màn hình chính (homeOverlay) nổi đè lên WebView -->
    <FrameLayout
        android:id="@+id/homeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/default_wallpaper"
            android:background="#FFFFFF" />

    </FrameLayout>

    <!-- Nút toggle desktop/mobile - ẩn, chuyển vào menu đa nhiệm -->
    <ImageButton
        android:id="@+id/btnDesktopSite"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:src="@drawable/ic_mobile_mode"
        android:background="@null"
        android:contentDescription="Chuyển bản máy tính / di động" />

    <!-- Thanh địa chỉ cố định dưới cùng - CHỈ hiện khi đang xem trang web, ẩn ở trang chủ vì
         trang chủ không phải trang web nên không cần nhập địa chỉ. -->
    <LinearLayout
        android:id="@+id/toolbarUrl"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/toolbar_bg"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edtUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/edit_url_bg"
            android:padding="10dp"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="Nhập địa chỉ web..." />

        <ImageButton
            android:id="@+id/btnShortcuts"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:src="@drawable/ic_triangle_down"
            android:contentDescription="Đề xuất trang" />

        <!-- ẩn, vẫn giữ id để code không crash -->
        <TextView
            android:id="@+id/btnSettingsMain"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- ẩn, vẫn giữ id -->
        <TextView
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- ẩn, vẫn giữ id -->
        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
