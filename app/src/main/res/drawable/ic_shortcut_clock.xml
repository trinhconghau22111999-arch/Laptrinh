<!-- Đồng hồ: analog clock kiểu WP - vòng tròn + kim giờ/phút rõ ràng -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- Vòng tròn mặt đồng hồ -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.8" android:fillColor="@android:color/transparent"
        android:pathData="M12,12m-9,0a9,9 0 1,0 18,0a9,9 0 1,0 -18,0"/>
    <!-- Kim giờ (chỉ 9 giờ = sang trái) -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="2" android:strokeLineCap="round"
        android:pathData="M12,12L8.5,12"/>
    <!-- Kim phút (chỉ 12 giờ = lên trên) -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.5" android:strokeLineCap="round"
        android:pathData="M12,12L12,5.5"/>
    <!-- Tâm đồng hồ -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M12,12m-1,0a1,1 0 1,0 2,0a1,1 0 1,0 -2,0"/>
    <!-- 4 vạch chia giờ chính (12, 3, 6, 9) -->
    <path android:strokeColor="#FFFFFF" android:strokeWidth="1.5"
        android:pathData="M12,3.5L12,4.5  M20.5,12L19.5,12  M12,20.5L12,19.5  M3.5,12L4.5,12"/>
</vector>
