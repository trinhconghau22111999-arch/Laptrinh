<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp NỀN của icon app (adaptive icon) - phủ kín 108x108, hệ thống sẽ tự cắt theo hình dạng
     mask riêng của từng dòng máy (tròn/vuông bo/giọt nước...). Gradient chéo tím->xanh giữ
     đúng 2 màu thương hiệu đã dùng xuyên suốt giao diện app (xem neon_purple/#C724FF trong
     values.xml), pha thêm xanh dương để nổi bật hơn nền đen của app khi hiện ở màn hình chính. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="4" android:startY="4"
                android:endX="104" android:endY="104"
                android:startColor="#9A1FFF"
                android:endColor="#12A7EE" />
        </aapt:attr>
    </path>

    <!-- Quầng sáng mềm phía sau, tạo chiều sâu, tránh cảm giác phẳng. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.12"
        android:pathData="M54,10 A44,44 0 1,0 54,98 A44,44 0 1,0 54,10 Z" />
</vector>
