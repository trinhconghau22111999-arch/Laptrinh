<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp TRƯỚC icon app - phiên bản tối giản chỉ 2 màu (xanh dương nền + trắng lớp trước):
     quả địa cầu (vòng tròn + 2 nét "kinh tuyến" cong + 1 "vĩ tuyến" dọc) tượng trưng trình
     duyệt web, kèm huy hiệu tròn nhỏ có gạch chéo ở góc dưới-phải tượng trưng "chặn quảng
     cáo". Toàn bộ nằm trong vùng an toàn (~66dp) giữa canvas 108x108. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vòng ngoài quả địa cầu -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M48,48 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />

    <!-- Vĩ tuyến dọc -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M48,30 L48,66" />

    <!-- 2 kinh tuyến cong -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M30,48 Q48,38 66,48" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M30,48 Q48,58 66,48" />

    <!-- Huy hiệu "chặn" - đè lên góc dưới-phải quả địa cầu -->
    <path
        android:fillColor="#0068FF"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M70,70 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:pathData="M64,64 L76,76" />
</vector>
