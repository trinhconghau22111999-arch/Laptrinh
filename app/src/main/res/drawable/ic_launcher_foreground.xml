<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp TRƯỚC của icon app (adaptive icon) - nội dung chính PHẢI nằm gọn trong vùng an toàn
     (hình tròn ~66-72dp giữa canvas 108x108) vì hệ thống có thể cắt phần ngoài vùng này theo
     mask riêng của từng máy. KHIÊN trắng (bảo vệ/trình duyệt) + HUY HIỆU ĐỎ dấu "cấm" (chặn) ở
     góc dưới phải - để icon nói rõ đây là app CHẶN quảng cáo, không chỉ chung chung "bảo mật". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Thân khiên - bo tròn mềm mại, thu gọn trong vùng an toàn. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26
            C47,26 40,28.3 34.3,32.3
            C33.2,33.1 32.5,34.4 32.5,35.7
            L32.5,54
            C32.5,67 40,77.5 54,84
            C68,77.5 75.5,67 75.5,54
            L75.5,35.7
            C75.5,34.4 74.8,33.1 73.7,32.3
            C68,28.3 61,26 54,26 Z" />

    <!-- Huy hiệu đỏ hình tròn "cấm/chặn" đè lên góc dưới-phải khiên, viền trắng để tách lớp
         rõ ràng khỏi khiên bên dưới. -->
    <path
        android:fillColor="#FF3B30"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:pathData="M94,76 A18,18 0 1,1 58,76 A18,18 0 1,1 94,76 Z" />

    <!-- Gạch chéo trắng trong huy hiệu - biểu tượng "cấm/chặn" quốc tế. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M65.5,65.5 L86.5,86.5" />
</vector>
