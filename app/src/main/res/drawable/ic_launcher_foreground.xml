<!-- Lớp TRƯỚC icon app - ĐÚNG logo "Start" 4 ô vuông trắng (2x2, khe hở nhỏ ở giữa) của
     Windows Phone/Windows 10 Mobile thật, giống hệt [R.drawable.ic_wp_start] dùng cho nút
     "Start" trong dock ở trang Điện thoại (xem DesktopActivity.kt) - THAY CHO icon quả địa
     cầu+huy hiệu chặn trước đây, để icon app trên màn hình chính CŨNG mang đúng bản sắc WP
     thay vì kiểu icon "trình duyệt chặn quảng cáo" chung chung. Toạ độ nhân đôi từ bản 24x24
     gốc (x6, giữ nguyên tỉ lệ) để vừa khớp vùng an toàn ~66dp giữa canvas 108x108 của icon
     "adaptive" (Android 8.0+). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:fillColor="#FFFFFF" android:pathData="M27,27h30v30h-30z" />
    <path android:fillColor="#FFFFFF" android:pathData="M63,27h30v30h-30z" />
    <path android:fillColor="#FFFFFF" android:pathData="M27,63h30v30h-30z" />
    <path android:fillColor="#FFFFFF" android:pathData="M63,63h30v30h-30z" />
</vector>
