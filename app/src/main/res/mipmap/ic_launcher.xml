<?xml version="1.0" encoding="utf-8"?>
<!-- Fallback cho máy Android CŨ HƠN 8.0 (API 24-25, chưa hỗ trợ <adaptive-icon>) - chỉ đơn
     giản chồng 2 lớp nền + trước lại thành 1 hình vuông cố định (giống cách hiển thị icon kiểu
     cũ trước Android 8.0). Từ Android 8.0 trở lên, hệ thống ưu tiên dùng
     mipmap-anydpi-v26/ic_launcher.xml (adaptive) thay vì file này. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
